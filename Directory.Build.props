<Project>

  <!-- Settings every project in the repo shares. A project overrides only what it must. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Keep build output out of the source tree. -->
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
  </PropertyGroup>

  <!-- One version for every package. Bump here, and only here, at release time. -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == '' and '$(ContinuousIntegrationBuild)' != 'true'">dev</VersionSuffix>
  </PropertyGroup>

  <!-- Package metadata. Projects that ship set IsPackable; everything else is IsPackable=false. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <Authors>Sonde contributors</Authors>
    <Company>Sonde</Company>
    <Copyright>Copyright (c) Sonde contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/srose-io/sonde</PackageProjectUrl>
    <RepositoryUrl>https://github.com/srose-io/sonde</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>dotnet;debugging;diagnostics;roslyn;eval;harmony;mcp</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)docs/assets/icon.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <!-- Every packable project tracks its public surface in PublicAPI.Shipped.txt / PublicAPI.Unshipped.txt
       (the analyzer package adds both as AdditionalFiles itself). -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

</Project>
