{
  "version": 1,
  "gates": [
    {
      "id": "build",
      "tier": "fast",
      "run": "dotnet build Sonde.sln -warnaserror --nologo -v q",
      "timeoutSeconds": 600
    },
    {
      "id": "unit",
      "tier": "full",
      "run": "dotnet test Sonde.sln --no-build --nologo --filter 'Category!=EndToEnd'",
      "timeoutSeconds": 900
    },
    {
      "id": "e2e",
      "tier": "full",
      "run": "dotnet test tests/Sonde.EndToEnd --no-build --nologo",
      "timeoutSeconds": 1200
    }
  ]
}
