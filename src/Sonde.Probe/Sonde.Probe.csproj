<Project Sdk="Microsoft.NET.Sdk">

  <!-- Sonde.Probe: the in-process agent. Loaded into a .NET process through DOTNET_STARTUP_HOOKS,
       it opens a local listener and runs compiled scripts the client sends in. It targets the
       lowest supported host (net8.0) because a hook built for 8 loads into 9 and 10 hosts and the
       reverse does not. See docs/decisions/0002-probe-dependencies.md. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Sonde.Probe</RootNamespace>
    <AssemblyName>Sonde.Probe</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>Sonde.Probe</PackageId>
    <Description>The Sonde in-process agent: a startup hook that runs compiled C# inside a live .NET process over a local socket.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Harmony is private to the probe: nothing flows to a consumer through NuGet. The probe
         ships Harmony's own per-runtime builds under harmony/net{8,9,10}.0/ (below) and loads the
         one matching the host at runtime, so a net9.0 consumer never hands a net8.0 host a Harmony
         it cannot load. -->
    <PackageReference Include="Lib.Harmony" PrivateAssets="all" ExcludeAssets="runtime" GeneratePathProperty="true" />
    <!-- Compile against the DI abstractions but never ship them: the agent binds to whichever
         copy the host already loaded, in a web app or a worker service alike. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- The per-runtime Harmony builds, copied beside the probe in every build output that references
       it (directly or through Sonde), and packed under buildTransitive/ so a NuGet consumer gets the
       same layout through Sonde.Probe.targets. -->
  <ItemGroup>
    <HarmonyFlavour Include="$(PkgLib_Harmony)/lib/net8.0/0Harmony.dll" Flavour="net8.0" />
    <HarmonyFlavour Include="$(PkgLib_Harmony)/lib/net9.0/0Harmony.dll" Flavour="net9.0" />
    <HarmonyFlavour Include="$(PkgLib_Harmony)/lib/net10.0/0Harmony.dll" Flavour="net10.0" />
    <None Include="@(HarmonyFlavour)" Link="harmony/%(Flavour)/0Harmony.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" Pack="true" PackagePath="buildTransitive/harmony/%(Flavour)/" />
    <None Include="Sonde.Probe.targets" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sonde.Probe.Tests" />
    <!-- The other suites start the listener in-process to drive the client end to end. -->
    <InternalsVisibleTo Include="Sonde.Tests" />
    <InternalsVisibleTo Include="Sonde.Cli.Tests" />
    <InternalsVisibleTo Include="Sonde.Mcp.Tests" />
  </ItemGroup>

</Project>
